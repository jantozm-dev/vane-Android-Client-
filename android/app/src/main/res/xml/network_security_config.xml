<?xml version="1.0" encoding="utf-8"?>
<!-- Self-hosted Vane instances are usually served over plain HTTP on the
     local network, e.g. http://192.168.1.50:3000. Allow cleartext so the
     app can talk to them. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true" />
</network-security-config>
